{
  "name": "token-arcade",
  "version": "0.1.3",
  "description": "Turn AI coding tokens into a cozy 3D river valley town.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "token-arcade": "bin/token-arcade.mjs"
  },
  "files": [
    "bin",
    "dist",
    "ARCHITECTURE.md",
    "LICENSE",
    "README.md",
    "public/index.html",
    "public/app.js",
    "public/town.css",
    "public/assets/town"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevin9703/token-arcade.git"
  },
  "bugs": {
    "url": "https://github.com/Kevin9703/token-arcade/issues"
  },
  "homepage": "https://kevin9703.github.io/token-arcade/?demo=1",
  "keywords": [
    "claude-code",
    "codex",
    "token-tracking",
    "local-first",
    "gamification",
    "threejs",
    "town-builder",
    "cozy-game"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:assets && npm run build:client && npm run build:server",
    "build:client": "esbuild src/town/main.ts --bundle --format=iife --outfile=public/app.js --sourcemap --minify",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs",
    "watch": "esbuild src/town/main.ts --bundle --format=iife --outfile=public/app.js --sourcemap --watch",
    "start": "node --experimental-strip-types --no-warnings server/index.ts",
    "dev": "npm run build && npm run start",
    "test": "node scripts/run-tests.mjs",
    "prepack": "npm run build",
    "build:assets": "node scripts/build-town-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.24.0",
    "playwright-core": "1.48",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "lucide": "^1.49.0",
    "three": "^0.186.1"
  }
}
